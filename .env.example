# Beyond Signal — environment variables (all optional)
# Copy to `.env.local` and fill in as needed. Never commit real secrets.

# Canonical base URL used in metadata + sitemap.
NEXT_PUBLIC_SITE_URL=https://beyond-signal.example.com

# ── AI natural-language search (optional) ─────────────────────────────────
# Leave these unset to use the built-in local search engine.
# Set ANTHROPIC_API_KEY to upgrade /ask to Claude-powered answers.
# The key is read server-side only and is never exposed to the browser.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-5).
ANTHROPIC_MODEL=

# ── User accounts (optional) ──────────────────────────────────────────────
# Leave unset to run in guest mode (saves persist to the browser's
# localStorage). Set both to enable Supabase-backed accounts that sync saved
# discoveries across devices. Create a project at https://supabase.com and run
# supabase/migrations/0001_init.sql, then paste the values from
# Project Settings → API below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Notion content source (optional) ──────────────────────────────────────
# Leave unset to use the built-in flat-file catalog (src/content/discoveries).
# Set these and run `npm run sync:notion` to pull the catalog from a Notion
# database into src/content/discoveries.generated.ts.
NOTION_API_KEY=
NOTION_DISCOVERIES_DB_ID=

# Beyond Signal — environment variables (all optional)
# Copy to `.env.local` and fill in as needed. Never commit real secrets.

# Canonical base URL used in metadata + sitemap.
NEXT_PUBLIC_SITE_URL=https://beyond-signal.example.com

# ── AI natural-language search (optional) ─────────────────────────────────
# Leave these unset to use the built-in local search engine.
# Set ANTHROPIC_API_KEY to upgrade /ask to Claude-powered answers.
# The key is read server-side only and is never exposed to the browser.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-5).
ANTHROPIC_MODEL=
